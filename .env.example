# Public base URL of the deployed site, no trailing slash.
# Used for metadata (metadataBase), Open Graph / Twitter URLs, canonical URL,
# robots.txt and sitemap.xml. Set this in the Vercel project settings.
# If unset, the build falls back to https://asfamily.gg
NEXT_PUBLIC_SITE_URL=https://asfamily.gg

# Discord guild id used to read the public Server Widget JSON
# (https://discord.com/api/guilds/<id>/widget.json). Not a secret — no bot
# token is used. Optional; falls back to the AS FAMILY server id if unset.
DISCORD_GUILD_ID=1327023198323347496
